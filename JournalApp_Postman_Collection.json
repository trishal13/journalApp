{
	"info": {
		"_postman_id": "journal-app-collection",
		"name": "Journal App API",
		"description": "Complete API collection for Journal App. Run in order: Health Check → Signup → Login → Journal CRUD → User → Admin",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "entry_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Public Endpoints",
			"item": [
				{
					"name": "1.1 Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/public/health-check",
							"host": ["{{base_url}}"],
							"path": ["public", "health-check"]
						}
					}
				},
				{
					"name": "1.2 Signup",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userName\": \"johndoe\",\n  \"password\": \"password123\",\n  \"email\": \"johndoe@example.com\",\n  \"sentimentAnalysis\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/public/signup",
							"host": ["{{base_url}}"],
							"path": ["public", "signup"]
						}
					}
				},
				{
					"name": "1.3 Login (auto-saves token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('jwt_token', jsonData.data.token);",
									"    console.log('JWT token saved: ' + jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userName\": \"johndoe\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/public/login",
							"host": ["{{base_url}}"],
							"path": ["public", "login"]
						}
					}
				},
				{
					"name": "1.4 Signup Duplicate (should fail 409)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userName\": \"johndoe\",\n  \"password\": \"password123\",\n  \"email\": \"johndoe@example.com\",\n  \"sentimentAnalysis\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/public/signup",
							"host": ["{{base_url}}"],
							"path": ["public", "signup"]
						}
					}
				}
			]
		},
		{
			"name": "2. Journal Entries (Auth Required)",
			"item": [
				{
					"name": "2.1 Create Journal Entry",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('entry_id', jsonData.data.id);",
									"    console.log('Entry ID saved: ' + jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"My first journal entry\",\n  \"content\": \"Today was a wonderful day! I went to the park and enjoyed the sunshine.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/journal",
							"host": ["{{base_url}}"],
							"path": ["journal"]
						}
					}
				},
				{
					"name": "2.2 Create Another Entry",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Rough day at work\",\n  \"content\": \"Everything went wrong today. I feel so frustrated and angry about the situation.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/journal",
							"host": ["{{base_url}}"],
							"path": ["journal"]
						}
					}
				},
				{
					"name": "2.3 Get All Journal Entries",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/journal",
							"host": ["{{base_url}}"],
							"path": ["journal"]
						}
					}
				},
				{
					"name": "2.4 Get Entry by ID",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/journal/id/{{entry_id}}",
							"host": ["{{base_url}}"],
							"path": ["journal", "id", "{{entry_id}}"]
						}
					}
				},
				{
					"name": "2.5 Update Entry",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Updated: Great day actually\",\n  \"content\": \"Reflecting on it, today was actually pretty good.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/journal/id/{{entry_id}}",
							"host": ["{{base_url}}"],
							"path": ["journal", "id", "{{entry_id}}"]
						}
					}
				},
				{
					"name": "2.6 Delete Entry",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/journal/id/{{entry_id}}",
							"host": ["{{base_url}}"],
							"path": ["journal", "id", "{{entry_id}}"]
						}
					}
				}
			]
		},
		{
			"name": "3. User Endpoints (Auth Required)",
			"item": [
				{
					"name": "3.1 Greeting with Weather",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/user?lat=28.6139&lon=77.2090",
							"host": ["{{base_url}}"],
							"path": ["user"],
							"query": [
								{ "key": "lat", "value": "28.6139" },
								{ "key": "lon", "value": "77.2090" }
							]
						}
					}
				},
				{
					"name": "3.2 Update User",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userName\": \"johndoe_updated\",\n  \"password\": \"newpassword123\",\n  \"email\": \"updated@example.com\",\n  \"sentimentAnalysis\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/user",
							"host": ["{{base_url}}"],
							"path": ["user"]
						}
					}
				},
				{
					"name": "3.3 Delete User",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/user",
							"host": ["{{base_url}}"],
							"path": ["user"]
						}
					}
				}
			]
		},
		{
			"name": "4. Admin Endpoints (ADMIN Role)",
			"item": [
				{
					"name": "4.1 Create Admin User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userName\": \"adminuser\",\n  \"password\": \"adminpass123\",\n  \"email\": \"admin@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/create-admin-user",
							"host": ["{{base_url}}"],
							"path": ["admin", "create-admin-user"]
						}
					}
				},
				{
					"name": "4.2 Login as Admin (auto-saves token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('jwt_token', jsonData.data.token);",
									"    console.log('Admin JWT saved!');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userName\": \"adminuser\",\n  \"password\": \"adminpass123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/public/login",
							"host": ["{{base_url}}"],
							"path": ["public", "login"]
						}
					}
				},
				{
					"name": "4.3 Get All Users",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/admin/all-users",
							"host": ["{{base_url}}"],
							"path": ["admin", "all-users"]
						}
					}
				},
				{
					"name": "4.4 Clear App Cache",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/admin/clear-app-cache",
							"host": ["{{base_url}}"],
							"path": ["admin", "clear-app-cache"]
						}
					}
				},
				{
					"name": "4.5 Trigger Weekly Sentiment Report",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/admin/trigger-weekly-sentiment",
							"host": ["{{base_url}}"],
							"path": ["admin", "trigger-weekly-sentiment"]
						}
					}
				},
				{
					"name": "4.6 Get All Configs",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/admin/configs",
							"host": ["{{base_url}}"],
							"path": ["admin", "configs"]
						}
					}
				},
				{
					"name": "4.7 Update Config by Key",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"value\": \"https://api.openweathermap.org/data/2.5/weather?lat=<lat>&lon=<lon>&appid=<apiKey>\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/configs/WEATHER_API",
							"host": ["{{base_url}}"],
							"path": ["admin", "configs", "WEATHER_API"]
						}
					}
				},
				{
					"name": "4.8 Update User by Username (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newemail@example.com\",\n  \"sentimentAnalysis\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/users/johndoe",
							"host": ["{{base_url}}"],
							"path": ["admin", "users", "johndoe"]
						}
					}
				},
				{
					"name": "4.9 Get User Journals (Admin)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/admin/users/johndoe/journals",
							"host": ["{{base_url}}"],
							"path": ["admin", "users", "johndoe", "journals"]
						}
					}
				}
			]
		}
	]
}